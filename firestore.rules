// Firestore security rules for the Ledger app.
// Paste into Firebase console > Firestore Database > Rules, then Publish.
//
// Each business lives under businesses/{ownerUid}. Its owner is the person whose UID is the
// business id; its salespeople are the documents in businesses/{ownerUid}/staff that aren't
// marked inactive. users/{uid} tells a salesperson's login which business it belongs to.
// No one can read or change another business's data.
//
// The platform admin (the UID in isAdmin) can list every business, approve new ones, and
// suspend or restore one. A new business waits for the admin's approval (approved == false)
// before its owner can use it; businesses created before approval existed have no
// "approved" field and count as approved. A suspended or not-yet-approved business's owner
// and salespeople have no access to its data. The admin can see business names, owners and
// teams, not their transactions.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function bizPath(b) { return /databases/$(database)/documents/businesses/$(b); }
    function staffPath(b) { return /databases/$(database)/documents/businesses/$(b)/staff/$(request.auth.uid); }
    function isAdmin() { return signedIn() && request.auth.uid == '0xxeZTLlaAeTzTgpezc58hwDxXp2'; }
    function isOwnerOf(b) { return signedIn() && request.auth.uid == b; }
    function isStaffOf(b) { return signedIn() && exists(staffPath(b)) && get(staffPath(b)).data.get('active', true) == true; }
    // A business that hasn't been created yet counts as active (its owner fills it in first).
    // Otherwise it must be approved (no field = approved, for older businesses) and not suspended.
    function bizActive(b) { return !exists(bizPath(b))
      || (get(bizPath(b)).data.get('suspended', false) == false && get(bizPath(b)).data.get('approved', true) == true); }
    function isMemberOf(b) { return (isOwnerOf(b) || isStaffOf(b)) && bizActive(b); }

    match /businesses/{b} {
      // Its own team can always read the business document (so the app can tell them it's
      // suspended); the admin can read and list them all.
      allow read: if isOwnerOf(b) || isStaffOf(b) || isAdmin();
      // Anyone can create a business, but only as its owner, under their own UID, with a
      // confirmed email (the platform admin is exempt), having accepted the Terms of Use and Privacy Policy, never
      // pre-suspended or un-suspendable, and waiting for approval (the admin's own is exempt).
      allow create: if isOwnerOf(b) && request.resource.data.ownerUid == b
        && (request.auth.token.email_verified == true || isAdmin())
        && request.resource.data.termsAcceptedAt == request.time
        && request.resource.data.termsVersion is string
        && !('suspended' in request.resource.data)
        && (request.resource.data.get('approved', null) == false || isAdmin());
      // The owner edits their business (e.g. its name) but can't lift a suspension or approve
      // it; the admin can only approve, suspend or restore.
      allow update: if (isOwnerOf(b) && bizActive(b)
          && request.resource.data.ownerUid == b
          && request.resource.data.get('suspended', false) == resource.data.get('suspended', false)
          && request.resource.data.get('approved', true) == resource.data.get('approved', true))
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended', 'suspendedAt', 'approved', 'approvedAt']));
      allow delete: if false;

      match /transactions/{txId} {
        // The whole team sees the business's transactions in the Transaction Log; a
        // salesperson's totals and reports cover only their own entries (done in the app).
        allow read: if isMemberOf(b);

        // The owner can write anything in their own business. A salesperson can log only
        // as themselves, stamped with the server's time.
        allow create: if (isOwnerOf(b) && bizActive(b)) || (isMemberOf(b) && isStaffOf(b)
          && request.resource.data.loggedBy == request.auth.uid
          && request.resource.data.deleted == false
          && request.resource.data.createdAt == request.time);

        // A salesperson can't erase anything: "delete" only marks their own entry as deleted,
        // within 3h50m of logging. The owner still sees it, with who deleted it and when.
        allow update: if (isOwnerOf(b) && bizActive(b)) || (isMemberOf(b) && isStaffOf(b)
          && resource.data.loggedBy == request.auth.uid
          && resource.data.deleted == false
          && request.time < resource.data.createdAt + duration.value(230, 'm')
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt', 'deletedBy'])
          && request.resource.data.deleted == true
          && request.resource.data.deletedBy == request.auth.uid
          && request.resource.data.deletedAt == request.time);

        allow delete: if isOwnerOf(b) && bizActive(b);
      }

      // Fee rates and tips: the team reads, only the owner changes.
      match /settings/{doc} {
        allow read: if isMemberOf(b);
        allow write: if isOwnerOf(b) && bizActive(b);
      }

      // Team list (who has access, and their names): the team reads, only the owner changes.
      // The admin can read it to see who runs each business.
      match /staff/{uid} {
        allow read: if isMemberOf(b) || isAdmin();
        allow write: if isOwnerOf(b) && bizActive(b);
      }
    }

    // Which business a salesperson's login belongs to. Only that business's owner can set it,
    // only for a business that exists, and never for a login that belongs to another business.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || resource.data.businessId == request.auth.uid);
      allow create, update: if signedIn() && uid != request.auth.uid
        && request.resource.data.businessId == request.auth.uid
        && request.resource.data.role == 'staff'
        && existsAfter(bizPath(request.auth.uid))
        && (resource == null || resource.data.businessId == request.auth.uid);
      allow delete: if signedIn() && resource.data.businessId == request.auth.uid;
    }

    // Username → login lookup, so salespeople can sign in with a username. Readable by exact
    // name before signing in (never listable). A business owner can claim a free username for
    // their own business, and only that business can change or release it.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && name.matches('^[a-z0-9][a-z0-9._-]{2,29}$')
        && request.resource.data.keys().hasOnly(['email', 'businessId'])
        && request.resource.data.businessId == request.auth.uid
        && request.resource.data.email is string
        && existsAfter(bizPath(request.auth.uid));
      allow update: if signedIn() && resource.data.businessId == request.auth.uid
        && request.resource.data.keys().hasOnly(['email', 'businessId'])
        && request.resource.data.businessId == request.auth.uid;
      allow delete: if signedIn() && resource.data.businessId == request.auth.uid;
    }

    // ---- Original single-business ledger (before businesses) ----
    // Kept as a backup and so phones still on the old version keep working until they reload.
    // The original owner copies it into their business the first time they sign in.
    function isLegacyOwner()  { return signedIn() && request.auth.uid == '0xxeZTLlaAeTzTgpezc58hwDxXp2'; }
    function legacyStaffDoc() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function isLegacyStaff()  { return signedIn() && exists(legacyStaffDoc()) && get(legacyStaffDoc()).data.get('active', true) == true; }
    function isLegacyMember() { return isLegacyOwner() || isLegacyStaff(); }

    match /transactions/{txId} {
      allow read: if isLegacyMember();
      allow create: if isLegacyMember()
        && request.resource.data.loggedBy == request.auth.uid
        && request.resource.data.deleted == false
        && request.resource.data.createdAt == request.time;
      allow update: if isLegacyOwner() || (isLegacyStaff()
        && resource.data.loggedBy == request.auth.uid
        && resource.data.deleted == false
        && request.time < resource.data.createdAt + duration.value(230, 'm')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt', 'deletedBy'])
        && request.resource.data.deleted == true
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.deletedAt == request.time);
      allow delete: if isLegacyOwner();
    }
    match /settings/{doc} {
      allow read: if isLegacyMember();
      allow write: if isLegacyOwner();
    }
    match /staff/{uid} {
      // A login can always check its own entry here (the app uses it to explain that the
      // business is being moved); otherwise the old team can read it and the owner manages it.
      allow read: if isLegacyMember() || (signedIn() && request.auth.uid == uid);
      allow write: if isLegacyOwner();
    }
  }
}
