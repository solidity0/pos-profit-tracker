// Firestore security rules for the Ledger app.
// Paste into Firebase console > Firestore Database > Rules, then Publish.
//
// Each business lives under businesses/{ownerUid}. Its owner is the person whose UID is the
// business id; its salespeople are the documents in businesses/{ownerUid}/staff that aren't
// marked inactive. users/{uid} tells a salesperson's login which business it belongs to.
// No one can read or change another business's data.
//
// The platform admin (the UID in isAdmin) can list every business, approve or decline new
// ones, remove one's access for 3 months, and suspend or restore one. A new business waits for the admin's approval (approved == false)
// before its owner can use it (a declined one stays unapproved, marked declined); businesses
// created before approval existed have no
// "approved" field and count as approved. A suspended or not-yet-approved business's owner
// and salespeople have no access to its data. The admin can see business names, owners and
// teams, not their transactions.
//
// Removing access (3 months) or suspending (for good) also blocks that owner's email and phone
// number from creating another business: blocked/{"e:"+email | "p:"+phone digits}, with an
// "until" time (removed) or none (suspended). After 3 months a removed owner can apply again,
// which puts their business back in the admin's waiting list.
//
// Owners can change their business name and their own name once every 30 days, and their
// phone number once every 90 days; their email stays as signed up. The admin is exempt.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function bizPath(b) { return /databases/$(database)/documents/businesses/$(b); }
    function staffPath(b) { return /databases/$(database)/documents/businesses/$(b)/staff/$(request.auth.uid); }
    function isAdmin() { return signedIn() && request.auth.uid == '0xxeZTLlaAeTzTgpezc58hwDxXp2'; }
    function isOwnerOf(b) { return signedIn() && request.auth.uid == b; }
    function isStaffOf(b) { return signedIn() && exists(staffPath(b)) && get(staffPath(b)).data.get('active', true) == true; }
    // A business that hasn't been created yet counts as active (its owner fills it in first).
    // Otherwise it must be approved (no field = approved, for older businesses) and not suspended.
    function bizActive(b) { return !exists(bizPath(b))
      || (get(bizPath(b)).data.get('suspended', false) == false && get(bizPath(b)).data.get('approved', true) == true
          && get(bizPath(b)).data.get('removed', false) == false); }
    // Sign-up blocks (see above): in force when there's no end time, or it hasn't passed yet.
    function blockPath(key) { return /databases/$(database)/documents/blocked/$(key); }
    function blockedNow(key) { return exists(blockPath(key))
      && (get(blockPath(key)).data.get('until', null) == null || request.time < get(blockPath(key)).data.until); }
    function validPhone(p) { return p is string && p.matches('^[0-9]{10,15}$'); }
    // A detail that's limited to one change every `days` days: unchanged (with its change time
    // untouched), or changed now with its change time set to now, at least `days` after the last.
    function editOk(f, at, days) {
      return isAdmin()
        || (request.resource.data.get(f, null) == resource.data.get(f, null)
            && request.resource.data.get(at, null) == resource.data.get(at, null))
        || (request.resource.data.get(at, null) == request.time
            && (resource.data.get(at, null) == null || request.time > resource.data.get(at, null) + duration.value(days, 'd')));
    }
    function isMemberOf(b) { return (isOwnerOf(b) || isStaffOf(b)) && bizActive(b); }

    // A transaction can be deleted only on the day it was logged (Nigerian time, UTC+1) and
    // within the given minutes of logging (the server's time, so a phone's clock can't stretch it).
    function watDay(t) { return math.floor((t.toMillis() + 3600000) / 86400000); }
    function deleteWindowOk(mins) {
      return request.time < resource.data.createdAt + duration.value(mins, 'm')
        && watDay(request.time) == watDay(resource.data.createdAt);
    }

    match /businesses/{b} {
      // Its own team can always read the business document (so the app can tell them it's
      // suspended); the admin can read and list them all.
      allow read: if isOwnerOf(b) || isStaffOf(b) || isAdmin();
      // Anyone can create a business, but only as its owner, under their own UID, with a
      // confirmed email (the platform admin is exempt), having accepted the Terms of Use and Privacy Policy, never
      // pre-suspended or un-suspendable, and waiting for approval (the admin's own is exempt).
      allow create: if isOwnerOf(b) && request.resource.data.ownerUid == b
        && (request.auth.token.email_verified == true || isAdmin())
        && request.resource.data.termsAcceptedAt == request.time
        && request.resource.data.termsVersion is string
        && !('suspended' in request.resource.data) && !('declined' in request.resource.data) && !('removed' in request.resource.data)
        && (request.resource.data.get('approved', null) == false || isAdmin())
        // A phone number is required, and neither it nor the email may be blocked.
        && (isAdmin() || (validPhone(request.resource.data.get('ownerPhone', null))
            && !blockedNow('p:' + request.resource.data.ownerPhone)
            && !blockedNow('e:' + request.auth.token.email.lower())));
      // The owner edits their business (its name, their name, their phone, within the limits
      // above) but can't change its status (suspended, approved, declined, removed) or email.
      // The admin can only approve, decline, remove access, suspend or restore.
      allow update: if (isOwnerOf(b) && bizActive(b)
          && request.resource.data.ownerUid == b
          && request.resource.data.get('suspended', false) == resource.data.get('suspended', false)
          && request.resource.data.get('approved', true) == resource.data.get('approved', true)
          && request.resource.data.get('declined', false) == resource.data.get('declined', false)
          && request.resource.data.get('removed', false) == resource.data.get('removed', false)
          && (isAdmin() || request.resource.data.get('ownerEmail', null) == resource.data.get('ownerEmail', null))
          && editOk('name', 'nameChangedAt', 30)
          && editOk('ownerName', 'ownerNameChangedAt', 30)
          && editOk('ownerPhone', 'phoneChangedAt', 90)
          && (isAdmin() || request.resource.data.get('ownerPhone', null) == resource.data.get('ownerPhone', null)
              || (validPhone(request.resource.data.ownerPhone) && !blockedNow('p:' + request.resource.data.ownerPhone))))
        // 3 months after their access was removed, the owner can apply again: the business goes
        // back to waiting for approval (nothing opens until the admin approves it).
        || (isOwnerOf(b) && resource.data.get('removed', false) == true
          && resource.data.get('suspended', false) == false
          && request.time > resource.data.removedUntil
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['removed', 'approved', 'declined', 'appliedAgainAt'])
          && request.resource.data.removed == false && request.resource.data.approved == false
          && request.resource.data.get('declined', false) == false
          && request.resource.data.appliedAgainAt == request.time)
        || (isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['suspended', 'suspendedAt', 'approved', 'approvedAt', 'declined', 'declinedAt', 'removed', 'removedAt', 'removedUntil']));
      allow delete: if false;

      match /transactions/{txId} {
        // The whole team sees the business's transactions in the Transaction Log; a
        // salesperson's totals and reports cover only their own entries (done in the app).
        allow read: if isMemberOf(b);

        // The owner can write anything in their own business. A salesperson can log only
        // as themselves, stamped with the server's time.
        allow create: if (isOwnerOf(b) && bizActive(b)) || (isMemberOf(b) && isStaffOf(b)
          && request.resource.data.loggedBy == request.auth.uid
          && request.resource.data.deleted == false
          && request.resource.data.createdAt == request.time);

        // Deleting only marks an entry as deleted (the owner still sees it, with who and when),
        // and only on the day it was logged: staff their own entries within 2 hours, the owner
        // any entry within 3 hours. The owner can't move an entry's logged time.
        allow update: if (isOwnerOf(b) && bizActive(b)
            && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
            && (request.resource.data.get('deleted', false) != true || resource.data.get('deleted', false) == true
                || deleteWindowOk(180)))
          || (isMemberOf(b) && isStaffOf(b)
          && resource.data.loggedBy == request.auth.uid
          && resource.data.deleted == false
          && deleteWindowOk(120)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt', 'deletedBy'])
          && request.resource.data.deleted == true
          && request.resource.data.deletedBy == request.auth.uid
          && request.resource.data.deletedAt == request.time);

        allow delete: if isOwnerOf(b) && bizActive(b) && deleteWindowOk(180);
      }

      // Fee rates and tips: the team reads, only the owner changes.
      match /settings/{doc} {
        allow read: if isMemberOf(b);
        allow write: if isOwnerOf(b) && bizActive(b);
      }

      // Team list (who has access, and their names): the team reads, only the owner changes.
      // The admin can read it to see who runs each business.
      // Who has the app open right now (shown as a "breathing" name in the owner's filter).
      // Each member writes only their own row, stamped with the server's time; the team reads.
      match /presence/{uid} {
        allow read: if isMemberOf(b);
        allow create, update: if signedIn() && request.auth.uid == uid && isMemberOf(b)
          && request.resource.data.keys().hasOnly(['lastSeen', 'online'])
          && request.resource.data.lastSeen == request.time
          && request.resource.data.online is bool;
        allow delete: if false;
      }

      // The owner's own row carries their name, which must match the business's ownerName (so
      // renaming themselves goes through the 30-day limit there).
      match /staff/{uid} {
        allow read: if isMemberOf(b) || isAdmin();
        allow create: if isOwnerOf(b) && bizActive(b)
          && (uid != b || isAdmin() || request.resource.data.get('name', '') == getAfter(bizPath(b)).data.get('ownerName', ''));
        allow update: if isOwnerOf(b) && bizActive(b)
          && (uid != b || isAdmin() || request.resource.data.get('name', null) == resource.data.get('name', null)
              || request.resource.data.get('name', '') == getAfter(bizPath(b)).data.get('ownerName', ''));
        allow delete: if isOwnerOf(b) && bizActive(b);
      }
    }

    // Which business a salesperson's login belongs to. Only that business's owner can set it,
    // only for a business that exists, and never for a login that belongs to another business.
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || resource.data.businessId == request.auth.uid);
      allow create, update: if signedIn() && uid != request.auth.uid
        && request.resource.data.businessId == request.auth.uid
        && request.resource.data.role == 'staff'
        && existsAfter(bizPath(request.auth.uid))
        && (resource == null || resource.data.businessId == request.auth.uid);
      allow delete: if signedIn() && resource.data.businessId == request.auth.uid;
    }

    // Sign-up blocks (see the top). Readable by exact key so the sign-up form can say so;
    // only the admin lists or changes them.
    match /blocked/{key} {
      allow get: if true;
      allow list, write: if isAdmin();
    }

    // Username → login lookup, so salespeople can sign in with a username. Readable by exact
    // name before signing in (never listable). A business owner can claim a free username for
    // their own business, and only that business can change or release it.
    match /usernames/{name} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && name.matches('^[a-z0-9][a-z0-9._-]{2,29}$')
        && request.resource.data.keys().hasOnly(['email', 'businessId'])
        && request.resource.data.businessId == request.auth.uid
        && request.resource.data.email is string
        && existsAfter(bizPath(request.auth.uid));
      allow update: if signedIn() && resource.data.businessId == request.auth.uid
        && request.resource.data.keys().hasOnly(['email', 'businessId'])
        && request.resource.data.businessId == request.auth.uid;
      allow delete: if signedIn() && resource.data.businessId == request.auth.uid;
    }

    // ---- Original single-business ledger (before businesses) ----
    // Kept as a backup and so phones still on the old version keep working until they reload.
    // The original owner copies it into their business the first time they sign in.
    function isLegacyOwner()  { return signedIn() && request.auth.uid == '0xxeZTLlaAeTzTgpezc58hwDxXp2'; }
    function legacyStaffDoc() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function isLegacyStaff()  { return signedIn() && exists(legacyStaffDoc()) && get(legacyStaffDoc()).data.get('active', true) == true; }
    function isLegacyMember() { return isLegacyOwner() || isLegacyStaff(); }

    match /transactions/{txId} {
      allow read: if isLegacyMember();
      allow create: if isLegacyMember()
        && request.resource.data.loggedBy == request.auth.uid
        && request.resource.data.deleted == false
        && request.resource.data.createdAt == request.time;
      allow update: if (isLegacyOwner()
          && request.resource.data.get('createdAt', null) == resource.data.get('createdAt', null)
          && (request.resource.data.get('deleted', false) != true || resource.data.get('deleted', false) == true
              || deleteWindowOk(180)))
        || (isLegacyStaff()
        && resource.data.loggedBy == request.auth.uid
        && resource.data.deleted == false
        && deleteWindowOk(120)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted', 'deletedAt', 'deletedBy'])
        && request.resource.data.deleted == true
        && request.resource.data.deletedBy == request.auth.uid
        && request.resource.data.deletedAt == request.time);
      allow delete: if isLegacyOwner() && deleteWindowOk(180);
    }
    match /settings/{doc} {
      allow read: if isLegacyMember();
      allow write: if isLegacyOwner();
    }
    match /staff/{uid} {
      // A login can always check its own entry here (the app uses it to explain that the
      // business is being moved); otherwise the old team can read it and the owner manages it.
      allow read: if isLegacyMember() || (signedIn() && request.auth.uid == uid);
      allow write: if isLegacyOwner();
    }
  }
}
